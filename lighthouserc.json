{
  "ci": {
    "collect": {
      "staticDistDir": "./",
      "url": ["http://localhost/index.html"],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "skipAudits": ["canonical", "tap-targets"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.4 }],
        "categories:accessibility": ["error", { "minScore": 0.8 }],
        "categories:best-practices": ["error", { "minScore": 0.75 }],
        "categories:seo": ["warn", { "minScore": 0.8 }],
        "resource-summary:document:size": ["error", { "maxNumericValue": 700000 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 1600000 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 900000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
